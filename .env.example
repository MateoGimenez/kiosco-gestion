# =============================================================================
# Variables de entorno del sistema del kiosco
# -----------------------------------------------------------------------------
# Copiá este archivo como ".env" en la RAÍZ del repo y completá los valores.
# El archivo ".env" NO se sube a git (está en .gitignore): ahí van las claves reales.
# Hay un solo .env para todo el proyecto; la API y Prisma lo leen desde la raíz.
# =============================================================================

# --- General ------------------------------------------------------------------

# Entorno: development (desarrollo), test (tests automáticos) o production (PC del kiosco).
NODE_ENV=development

# Zona horaria del kiosco. Se usa para calcular el "día de trabajo" y mostrar horas (ADR 002).
# No cambiar: Argentina.
TZ=America/Argentina/Buenos_Aires

# --- Base de datos (PostgreSQL 16) --------------------------------------------

# Solo para docker-compose.yml (desarrollo): usuario y clave del PostgreSQL del contenedor.
# Tienen que coincidir con las URLs de abajo. Si no se definen, Docker usa kiosco / kiosco_dev_local.
POSTGRES_USER=kiosco
POSTGRES_PASSWORD=cambiar_esta_clave

# Base principal. Formato: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE?schema=public
# En desarrollo con Docker (npm run db:up) los datos coinciden con docker-compose.yml.
# En la PC del kiosco: usuario y contraseña propios, elegidos al instalar (nunca los de ejemplo).
DATABASE_URL=postgresql://kiosco:cambiar_esta_clave@localhost:5432/kiosco_dev?schema=public

# Base SOLO para los tests automáticos: se borra y se recrea en cada corrida.
# Nunca apuntarla a la base principal. Se prepara con: npm run db:test:prepare
# (aplica las migraciones sobre esta base; los tests de integración usan esta URL).
DATABASE_URL_TEST=postgresql://kiosco:cambiar_esta_clave@localhost:5432/kiosco_test?schema=public

# --- Sesión y login (ADR 003) -------------------------------------------------

# Clave para firmar las sesiones (JWT). Larga y al azar; si se filtra, hay que cambiarla
# (al cambiarla se cierran todas las sesiones abiertas). Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# (La API no arranca si tiene menos de 32 bytes o es un valor de ejemplo.)

# Duración de la sesión en horas, desde que la persona entra (no se estira con el uso).
# Local = PC del mostrador y WiFi del local (USR-07). Remota = desde afuera con Tailscale.
# Las dos van de 1 a 12, y la remota no puede ser mayor que la local.
SESSION_HOURS=12
REMOTE_SESSION_HOURS=4

# Límite de intentos de login fallidos (NF-16). Se cuenta por usuario y por puerta:
# con LOGIN_MAX_ATTEMPTS fallos dentro de LOGIN_WINDOW_MINUTES, ese usuario queda
# bloqueado en esa puerta durante LOGIN_LOCK_MINUTES. Así alguien de afuera no puede
# dejar bloqueado a nadie en el mostrador.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# Topes de intentos de login por minuto (cuentan todos los intentos, no solo los fallidos):
# por puerta, y en la puerta local además por IP del equipo. Frenan una avalancha de nombres inventados.
LOGIN_MAX_PER_MINUTE=120
LOGIN_MAX_PER_MINUTE_IP=30

# "Costo" con el que se cifran las contraseñas (bcrypt). Más alto = más seguro y más lento.
# Entre 10 y 14 (en los tests automáticos se acepta desde 4). Se mide en la PC del kiosco
# al instalar: si entrar tarda más de 1 segundo, bajar a 11.
BCRYPT_COST=12

# Nivel de detalle del registro (log) del servidor: error, warn, info o debug.
LOG_LEVEL=info

# --- Puerta local: PC del mostrador y WiFi del local (ADR 003) ------------------
# La API escucha por dos "puertas". La local atiende a la PC y al WiFi del personal, por HTTP.

# Dónde escucha. 0.0.0.0 = en todas las placas de red de la PC (para que lleguen las tablets).
LOCAL_BIND=0.0.0.0
# Puerto de la puerta local. Las tablets entran a http://<IP de la PC>:3000
LOCAL_PORT=3000

# Redes que cuentan como "el local", separadas por coma (formato CIDR).
# Si la IP de quien entra no está acá, se rechaza. Por defecto, solo la propia PC.
# En la instalación se agrega la subred del WiFi del local, por ejemplo:
#   LOCAL_CIDRS=127.0.0.1/32,::1/128,192.168.1.0/24
# Solo se aceptan redes del local: loopback, privadas (10.x, 172.16-31.x, 192.168.x),
# link-local (169.254.x, fe80::/10) o ULA (fc00::/7).
# La API NO arranca si queda vacía, si incluye "todo internet" (0.0.0.0/0 o ::/0), un rango
# público (por ejemplo 0.0.0.0/1) o si se superpone con las direcciones de Tailscale (100.64.0.0/10).
LOCAL_CIDRS=127.0.0.1/32,::1/128

# Nombres o IP con los que se puede entrar por la puerta local, separados por coma
# (sin http:// ni puerto). Protege contra páginas que se hacen pasar por el kiosco.
# En la instalación se agrega la IP fija de la PC, por ejemplo:
#   LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1,192.168.1.10
LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- Puerta remota: acceso desde afuera con Tailscale (ADR 003, etapa 9) --------
# Apagada hasta la etapa 9. Solo le habla "tailscale serve", que pone el HTTPS.

# true = prender la puerta remota.
REMOTE_ENABLED=false
# Solo puede escuchar en la propia PC (127.0.0.1 o ::1); la API no arranca con otro valor.
REMOTE_BIND=127.0.0.1
# Puerto al que apunta: tailscale serve --bg --https=443 http://127.0.0.1:3001
REMOTE_PORT=3001
# Nombre de Tailscale de la PC (ej.: kiosco.tailnet-xxxx.ts.net), sin https://.
# Obligatorio si REMOTE_ENABLED=true.
REMOTE_HOST=

# --- Adjuntos de compras (etapa 5) ----------------------------------------------
# UPLOADS_DIR y UPLOAD_MAX_MB se agregan en la etapa 5.

# --- Copias de seguridad (etapa 8) ----------------------------------------------
# BACKUP_DIR, BACKUP_EXTRA_DIR, BACKUP_KEEP y BACKUP_MAX_AGE_HOURS se agregan en la etapa 8.
